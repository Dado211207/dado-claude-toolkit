{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_destructive_commands.py\"",
            "timeout": 15,
            "statusMessage": "dado-release-safety: checking command"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_protected_branch.py\"",
            "timeout": 15,
            "statusMessage": "dado-release-safety: checking branch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/remind_uncommitted.py\"",
            "timeout": 15,
            "statusMessage": "dado-release-safety: checking git status"
          }
        ]
      }
    ]
  }
}
