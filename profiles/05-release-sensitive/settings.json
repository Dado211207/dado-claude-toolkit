{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "extraKnownMarketplaces": {
    "dado-tools": {
      "source": {
        "source": "github",
        "repo": "Dado211207/dado-claude-toolkit"
      }
    }
  },

  "enabledPlugins": {
    "dado-core@dado-tools": true,
    "dado-release-safety@dado-tools": true
  },

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.git-credentials)",
      "Read(./**/.netrc)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.json)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --delete *)",
      "Bash(git push --tags *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",

      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X POST *)",

      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(twine upload *)",
      "Bash(netlify deploy *)",
      "Bash(vercel *)",
      "Bash(docker push *)",
      "Bash(kubectl apply *)",
      "Bash(terraform apply *)",

      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__delete_file"
    ]
  }
}
