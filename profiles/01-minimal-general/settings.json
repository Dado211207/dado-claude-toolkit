{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "extraKnownMarketplaces": {
    "dado-tools": {
      "source": {
        "source": "github",
        "repo": "Dado211207/dado-claude-toolkit"
      }
    }
  },

  "enabledPlugins": {
    "dado-core@dado-tools": true
  },

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.git-credentials)",
      "Read(./**/credentials.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)"
    ]
  }
}
